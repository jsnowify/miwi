{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{server,shared}/**"
    }
  },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
