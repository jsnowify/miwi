# Server-only. Never prefix these values with VITE_.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=miwi
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:5173
PORT=3001
# Optional: password reset is available only when both are configured.
# SMTP_URL=smtps://USER:PASSWORD@mail.example.com:465
# MAIL_FROM=Miwi <hello@example.com>
# Only set this to your known reverse-proxy IP addresses/CIDRs.
# TRUSTED_PROXY=127.0.0.1/8,::1/128
